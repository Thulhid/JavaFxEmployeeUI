<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="483.0" prefWidth="567.0" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21" fx:controller="com.example.demo2.MainController">
    <padding>
        <Insets bottom="10" left="10" right="10" top="10" />
    </padding>
   <GridPane minHeight="-Infinity" minWidth="-Infinity" prefHeight="126.0" prefWidth="400.0" VBox.vgrow="NEVER">
     <columnConstraints>
       <ColumnConstraints hgrow="SOMETIMES" maxWidth="298.2" minWidth="10.0" prefWidth="167.20001220703125" />
         <ColumnConstraints hgrow="ALWAYS" maxWidth="247.00002822875973" minWidth="0.0" prefWidth="177.60003662109375" />
         <ColumnConstraints hgrow="SOMETIMES" maxWidth="224.00002746582032" minWidth="10.0" prefWidth="92.00003662109373" />
       <ColumnConstraints hgrow="SOMETIMES" maxWidth="136.00000000000006" minWidth="10.0" prefWidth="110.39996337890625" />
     </columnConstraints>
     <rowConstraints>
       <RowConstraints maxHeight="85.59998092651367" minHeight="23.199990844726564" prefHeight="64.80001220703124" />
       <RowConstraints maxHeight="114.79999389648438" minHeight="10.0" prefHeight="73.59998779296873" vgrow="SOMETIMES" />
     </rowConstraints>
      <children>
          <TextField fx:id="txtFld" prefHeight="26.0" prefWidth="278.0" GridPane.rowIndex="1">
            <GridPane.margin>
               <Insets bottom="40.0" left="5.0" right="5.0" />
            </GridPane.margin>
            <opaqueInsets>
               <Insets />
            </opaqueInsets>
         </TextField>
      
          <!-- Buttons -->
          <Button onAction="#searchBtnAp" prefHeight="26.0" prefWidth="67.0" text="Search" GridPane.columnIndex="2" GridPane.rowIndex="1">
            <GridPane.margin>
               <Insets bottom="40.0" left="10.0" right="10.0" />
            </GridPane.margin>
         </Button>
          <Button onAction="#clearBtnAp" prefHeight="26.0" prefWidth="54.0" text="Clear" GridPane.columnIndex="3" GridPane.rowIndex="1">
            <GridPane.margin>
               <Insets bottom="40.0" />
            </GridPane.margin>
         </Button>
          <ComboBox fx:id="gndCmb" prefHeight="26.0" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <GridPane.margin>
               <Insets bottom="40.0" left="10.0" />
            </GridPane.margin>
         </ComboBox>
      
          <Label prefHeight="22.0" prefWidth="104.0" text="Search By Gender" GridPane.columnIndex="1">
            <GridPane.margin>
               <Insets left="10.0" />
            </GridPane.margin>
         </Label>
      
          <!-- Labels and Input Fields -->
          <Label prefHeight="30.0" prefWidth="145.0" text="Search By Name" GridPane.columnSpan="2">
            <GridPane.margin>
               <Insets left="5.0" />
            </GridPane.margin>
         </Label>
      </children>
      <VBox.margin>
         <Insets />
      </VBox.margin>
   </GridPane>

                <!-- TableView -->
    <TableView fx:id="tblEmployee" maxHeight="300.0" maxWidth="500.0" prefHeight="435.0" prefWidth="546.0">
        <columns>
            <TableColumn fx:id="nameColumn" maxWidth="150.0" prefWidth="150.0" text="Name" />
            <TableColumn fx:id="nicColumn" maxWidth="150.0" minWidth="0.0" prefWidth="150.0" text="NIC" />
            <TableColumn fx:id="genderColumn" maxWidth="100.0" prefWidth="100.0" text="Gender" />
        </columns>
    </TableView>
</VBox>
